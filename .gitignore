# ===== PyInstaller 构建产物（含 >100MB 文件，必须排除）=====
build/
dist/

# ===== Python 缓存 =====
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/

# ===== IDE / 工具 =====
.codebuddy/
.trae/
.vscode/
.idea/
*.swp

# ===== 日志与临时文件 =====
*.log
ffmpeg_debug.log
canvas-output-*.png
图标.png
.gh_login.out
*.tmp
*.bak

# ===== 系统 =====
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ===== 本地密钥 / token =====
*.token
.env

# 保留：bin/ffmpeg.exe、bin/ffprobe.exe、fonts/、所有 .py 源码、assets/
